# Anthropic (Claude) API - REQUIRED for AI coaching suggestions
ANTHROPIC_API_KEY=sk-ant-xxx

# Optional: Override default Claude model (default: claude-3-5-sonnet-20240620)
# Use a valid Claude 3.5 Sonnet model ID
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Note: Transcription is handled locally by Whisper (no API key needed)
# The Python backend (whisper_server.py) runs on localhost:3003

